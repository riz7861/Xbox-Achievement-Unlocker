<Page
    x:Class="XAU.Views.Pages.DebugPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:XAU.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DebugPage"
    d:DataContext="{d:DesignInstance local:DebugPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <ui:Button
                HorizontalAlignment="Left"
                Content="Test All Events Replacements"
                Command="{Binding ViewModel.TestEventReplacementsCommand}" />

            <Expander
                Margin="0,16,0,0"
                Header="Quantum Break Save Diff Helper (read-only)"
                IsExpanded="True">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock
                        Margin="0,0,0,8"
                        Text="Research only. Reads WGS save files into memory and never edits or restores them."
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,0,0,4"
                        FontWeight="SemiBold"
                        Text="Detected WGS folder" />
                    <TextBox
                        IsReadOnly="True"
                        Text="{Binding ViewModel.QuantumBreakWgsFolder}"
                        TextWrapping="Wrap" />

                    <WrapPanel Margin="0,12,0,8">
                        <ui:Button
                            Margin="0,0,8,0"
                            Content="Take Snapshot A"
                            Command="{Binding ViewModel.TakeQuantumBreakSnapshotACommand}" />
                        <ui:Button
                            Margin="0,0,8,0"
                            Content="Take Snapshot B"
                            Command="{Binding ViewModel.TakeQuantumBreakSnapshotBCommand}" />
                        <ui:Button
                            Margin="0,0,8,0"
                            Content="Compare Snapshots"
                            Command="{Binding ViewModel.CompareQuantumBreakSnapshotsCommand}" />
                        <ui:Button
                            Margin="0,0,8,0"
                            Content="Copy Report"
                            Command="{Binding ViewModel.CopyQuantumBreakSaveDiffReportCommand}" />
                        <ui:Button
                            Content="Export Report"
                            Command="{Binding ViewModel.ExportQuantumBreakSaveDiffReportCommand}" />
                    </WrapPanel>

                    <TextBlock
                        Margin="0,0,0,4"
                        Text="{Binding ViewModel.SnapshotASummary}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,0,0,4"
                        Text="{Binding ViewModel.SnapshotBSummary}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,0,0,12"
                        FontWeight="SemiBold"
                        Text="{Binding ViewModel.QuantumBreakSaveDiffStatus}"
                        TextWrapping="Wrap" />

                    <DataGrid
                        Height="280"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding ViewModel.QuantumBreakSaveDiffRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="80" Binding="{Binding ChangeType}" Header="Change" />
                            <DataGridTextColumn Width="220" Binding="{Binding RelativePath}" Header="Relative path" />
                            <DataGridTextColumn Width="90" Binding="{Binding SizeA}" Header="Size A" />
                            <DataGridTextColumn Width="90" Binding="{Binding SizeB}" Header="Size B" />
                            <DataGridTextColumn Width="110" Binding="{Binding HashAPrefix}" Header="Hash A" />
                            <DataGridTextColumn Width="110" Binding="{Binding HashBPrefix}" Header="Hash B" />
                            <DataGridTextColumn Width="170" Binding="{Binding TimestampA}" Header="Timestamp A" />
                            <DataGridTextColumn Width="170" Binding="{Binding TimestampB}" Header="Timestamp B" />
                            <DataGridTextColumn Width="*" Binding="{Binding ChangedByteRanges}" Header="Changed byte ranges" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock
                        Margin="0,12,0,4"
                        FontWeight="SemiBold"
                        Text="Diff report" />
                    <TextBox
                        Height="240"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        Text="{Binding ViewModel.QuantumBreakSaveDiffReport}"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto" />
                </StackPanel>
            </Expander>

            <Expander
                Margin="0,16,0,0"
                Header="Quantum Break Live Save Watcher (read-only research)"
                IsExpanded="True">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock
                        Margin="0,0,0,8"
                        Text="Observes settled WGS file changes only. It never edits or restores save data."
                        TextWrapping="Wrap" />

                    <WrapPanel Margin="0,0,0,8">
                        <ui:Button
                            Margin="0,0,8,0"
                            Content="Start Watch"
                            Command="{Binding ViewModel.StartQuantumBreakSaveWatchCommand}" />
                        <ui:Button
                            Margin="0,0,8,0"
                            Content="Stop Watch"
                            Command="{Binding ViewModel.StopQuantumBreakSaveWatchCommand}" />
                        <ui:Button
                            Margin="0,0,8,0"
                            Content="Copy Live Log"
                            Command="{Binding ViewModel.CopyQuantumBreakLiveChangeLogCommand}" />
                        <ui:Button
                            Margin="0,0,8,0"
                            Content="Export Filtered View"
                            Command="{Binding ViewModel.ExportQuantumBreakFilteredLiveChangeLogCommand}" />
                        <ui:Button
                            Margin="0,0,8,0"
                            Content="Compare last two Savegames versions"
                            Command="{Binding ViewModel.CompareLastTwoSavegamesVersionsCommand}" />
                        <ui:Button
                            Content="Export Savegames Diff"
                            Command="{Binding ViewModel.ExportQuantumBreakSavegamesDiffReportCommand}" />
                    </WrapPanel>

                    <WrapPanel Margin="0,0,0,12">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Show" />
                        <ComboBox
                            Width="170"
                            Margin="0,0,16,0"
                            ItemsSource="{Binding ViewModel.QuantumBreakLiveFilters}"
                            SelectedItem="{Binding ViewModel.SelectedQuantumBreakLiveFilter, Mode=TwoWay}" />
                        <CheckBox
                            VerticalAlignment="Center"
                            Content="Hide WGS metadata"
                            IsChecked="{Binding ViewModel.HideQuantumBreakWgsMetadata, Mode=TwoWay}" />
                    </WrapPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,8,4" FontWeight="SemiBold" Text="Last Savegames change" />
                        <TextBlock Grid.Column="1" Margin="0,0,24,4" Text="{Binding ViewModel.LastQuantumBreakSavegamesChangeTime}" />
                        <TextBlock Grid.Column="2" Margin="0,0,8,4" FontWeight="SemiBold" Text="Savegames changes" />
                        <TextBlock Grid.Column="3" Margin="0,0,0,4" Text="{Binding ViewModel.QuantumBreakSavegamesChangeCount}" />
                        <TextBlock Grid.Row="1" Margin="0,0,8,0" FontWeight="SemiBold" Text="Last Preferences change" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,24,0" Text="{Binding ViewModel.LastQuantumBreakPreferencesChangeTime}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,8,0" FontWeight="SemiBold" Text="Preferences changes" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ViewModel.QuantumBreakPreferencesChangeCount}" />
                    </Grid>

                    <TextBlock
                        Margin="0,0,0,8"
                        FontWeight="SemiBold"
                        Text="{Binding ViewModel.QuantumBreakWatchSessionSummary}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Margin="0,0,0,12"
                        FontWeight="SemiBold"
                        Text="{Binding ViewModel.QuantumBreakLiveWatchStatus}"
                        TextWrapping="Wrap" />

                    <DataGrid
                        Height="280"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding ViewModel.QuantumBreakLiveChanges}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Container}" Value="Savegames">
                                        <Setter Property="Background" Value="#26388E3C" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Container}" Value="Preferences">
                                        <Setter Property="Background" Value="#263F8EDB" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMetadataOnly}" Value="True">
                                        <Setter Property="Background" Value="#267F8C8D" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsImportant}" Value="True">
                                        <Setter Property="Background" Value="#4960B66A" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="100" Binding="{Binding ChangeType}" Header="Change" />
                            <DataGridTextColumn Width="110" Binding="{Binding Container}" Header="Container" />
                            <DataGridTextColumn Width="220" Binding="{Binding Signal}" Header="Signal" />
                            <DataGridTextColumn Width="*" Binding="{Binding RelativePath}" Header="Relative path" />
                            <DataGridTextColumn Width="175" Binding="{Binding Timestamp}" Header="Timestamp" />
                            <DataGridTextColumn Width="100" Binding="{Binding SizeDisplay}" Header="Size" />
                            <DataGridTextColumn Width="110" Binding="{Binding HashPrefix}" Header="Hash" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock
                        Margin="0,12,0,4"
                        FontWeight="SemiBold"
                        Text="Live change log" />
                    <TextBox
                        Height="180"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        Text="{Binding ViewModel.QuantumBreakLiveChangeLog}"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto" />

                    <TextBlock
                        Margin="0,12,0,8"
                        FontWeight="SemiBold"
                        Text="{Binding ViewModel.QuantumBreakSavegamesDiffStatus}"
                        TextWrapping="Wrap" />

                    <DataGrid
                        Height="260"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding ViewModel.QuantumBreakSavegamesDiffRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="80" Binding="{Binding ChangeType}" Header="Change" />
                            <DataGridTextColumn Width="*" Binding="{Binding RelativePath}" Header="Savegames file" />
                            <DataGridTextColumn Width="110" Binding="{Binding HashAPrefix}" Header="Old hash" />
                            <DataGridTextColumn Width="110" Binding="{Binding HashBPrefix}" Header="New hash" />
                            <DataGridTextColumn Width="110" Binding="{Binding TotalBytesChanged}" Header="Changed bytes" />
                            <DataGridTextColumn Width="2*" Binding="{Binding ChangedByteRanges}" Header="Changed byte ranges" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock
                        Margin="0,12,0,4"
                        FontWeight="SemiBold"
                        Text="Last Savegames version diff report" />
                    <TextBox
                        Height="240"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        Text="{Binding ViewModel.QuantumBreakSavegamesDiffReport}"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
